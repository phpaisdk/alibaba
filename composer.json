{
    "name": "aisdk/alibaba",
    "description": "Alibaba Cloud Model Studio provider for PHP AI SDK",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aisdk/core": "^0.11.0",
        "aisdk/openai-compatible": "^0.11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AiSdk\\Alibaba\\": "src/",
            "AiSdk\\": "src/Root/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyze src tests --level=8 --memory-limit=512M",
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
